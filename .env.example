# Copy to .env.local.
#
# Without a key the app still runs: it serves three fully written example
# debates so you can see exactly what it does before spending anything.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# Optional. Cap on how many debates one browser can start per hour,
# enforced in-process. Defaults to 12. Set to 0 to disable.
# MHDEBATE_RATE_LIMIT=12
