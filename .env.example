# Copy to .env.local.
#
# With nothing set, the app still runs: it serves three fully written example
# debates so you can see exactly what it does before spending anything.

# ---------------------------------------------------------------- provider
# "anthropic", "ollama", or "demo". Leave unset to infer: an Anthropic key wins,
# then any OLLAMA_* setting, then demo mode.
# MHDEBATE_PROVIDER=

# ------------------------------------------------------- hosted (Anthropic)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------- local (Ollama)
# Nothing here is required beyond picking a model — the defaults match a
# stock `ollama serve`.
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_HOST=http://127.0.0.1:11434

# Context window. The default in Ollama is small enough that the closing
# summary — which carries every take and every push-back — gets silently
# truncated. Raise this before you raise anything else.
# OLLAMA_NUM_CTX=8192

# How long Ollama keeps the model resident. One debate is ~12 calls, so
# unloading between them roughly doubles the wall-clock time.
# OLLAMA_KEEP_ALIVE=10m

# Requests in flight at once. One GPU does not benefit from six.
# OLLAMA_NUM_PARALLEL=2

# Only for models that expose a separate reasoning channel (deepseek-r1,
# qwen3). Leave unset — most models error if it is sent at all. Inline
# <think> tags are stripped either way.
# OLLAMA_THINK=

# OLLAMA_TEMPERATURE=0.8

# ------------------------------------------------------------------- misc
# Debates per IP per hour, in-process. 0 disables.
# MHDEBATE_RATE_LIMIT=12
